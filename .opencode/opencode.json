{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "github_*", "resource": "*", "effect": "deny" },
    { "action": "cloudflare_*", "resource": "*", "effect": "deny" },
    { "action": "context7_*", "resource": "*", "effect": "deny" },
    { "action": "sentry_*", "resource": "*", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/"
      },
      "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp"
      },
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=rbzlvvrmihmvbbiomoqe"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp"
      },
      "firebase": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "firebase-tools@latest",
          "mcp"
        ],
        "environment": {
          "npm_config_engine_strict": "false"
        }
      }
    }
  }
}
