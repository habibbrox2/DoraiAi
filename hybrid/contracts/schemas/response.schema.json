{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://broxlab.online/schemas/brox-kai-hybrid/response-1.0.schema.json",
  "title": "Brox Kai Hybrid Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "messageType", "requestId", "ok"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "messageType": { "const": "response" },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "ok": { "type": "boolean" },
    "data": { "type": "object" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 64 },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "retryable": { "type": "boolean" }
      }
    }
  },
  "oneOf": [
    {
      "properties": { "ok": { "const": true } },
      "required": ["data"],
      "not": { "properties": { "error": {} }, "required": ["error"] }
    },
    {
      "properties": { "ok": { "const": false } },
      "required": ["error"],
      "not": { "properties": { "data": {} }, "required": ["data"] }
    }
  ]
}
