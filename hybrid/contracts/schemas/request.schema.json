{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://broxlab.online/schemas/brox-kai-hybrid/request-1.0.schema.json",
  "title": "Brox Kai Hybrid Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "messageType",
    "requestId",
    "type",
    "payload"
  ],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "messageType": { "const": "request" },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$",
      "maxLength": 128
    },
    "payload": { "type": "object" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sentAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
